{% from "partials/icons.njk" import icon %}
<header class="navbar" id="navbar">
  <div class="navbar__container">
    <a href="{{ homeUrl }}" class="navbar__logo" aria-label="{{ t.common.homeLabel }}">
      <img src="/logos/meanify-logo.svg" alt="" width="40" height="38">
      <span class="navbar__brand">Meanify</span>
    </a>

    <nav class="navbar__nav" id="navMenu" aria-label="{{ t.common.mainNav }}">
      <ul class="navbar__links">
        <li class="navbar__item navbar__item--has-menu">
          <a href="{{ site.pages.services[lang] }}" class="navbar__link"{% if pageKey == "services" or svc %} aria-current="page"{% endif %}>{{ t.nav.services }} {{ icon("chevron", 14) }}</a>
          <ul class="navbar__submenu">
            {% for key in site.services %}
            <li><a href="{{ site.pages[key][lang] }}" class="navbar__sublink"{% if pageKey == key %} aria-current="page"{% endif %}>{{ t.services[key].name }}</a></li>
            {% endfor %}
          </ul>
        </li>
        {% for key in ["process", "insights", "about", "faq", "contact"] %}
        <li><a href="{{ site.pages[key][lang] }}" class="navbar__link"{% if pageKey == key or (key == "insights" and article) %} aria-current="page"{% endif %}>{{ t.nav.faqShort if key == "faq" else t.nav[key] }}</a></li>
        {% endfor %}
        <li><a href="{{ waUrl }}" class="navbar__link navbar__link--cta" target="_blank" rel="noopener noreferrer" data-lead="whatsapp" data-cta="header">{{ t.nav.cta }}</a></li>
      </ul>
    </nav>

    <div class="navbar__actions">
      <div class="lang-switcher" role="group" aria-label="{{ t.common.langSwitch }}">
        {% for l in site.langs %}
        {% if not loop.first %}<span class="lang-divider" aria-hidden="true">|</span>{% endif %}
        <a href="{{ alternates[l] or site.pages.home[l] }}" class="lang-btn{% if l == lang %} lang-btn--active{% endif %}" hreflang="{{ site.hreflang[l] }}" lang="{{ site.hreflang[l] }}" data-lang="{{ l }}" title="{{ i18n[l].langName }}"{% if l == lang %} aria-current="true"{% endif %}>{{ i18n[l].langShort }}</a>
        {% endfor %}
      </div>

      <button class="theme-toggle" id="themeToggle" type="button" aria-label="{{ t.common.themeToggle }}">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>

      <button class="navbar__hamburger" id="hamburgerBtn" type="button" aria-label="{{ t.common.menuToggle }}" aria-expanded="false" aria-controls="navMenu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>
