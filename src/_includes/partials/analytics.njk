{# Google Analytics 4 with Consent Mode v2.
   Analytics storage stays denied until the visitor accepts in the consent banner;
   advertising signals are always denied. #}
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  (function(){
    var c = null;
    try { c = localStorage.getItem('meanify-consent'); } catch (e) {}
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: c === 'granted' ? 'granted' : 'denied'
    });
  })();
  gtag('js', new Date());
  gtag('config', '{{ site.gaId }}', { page_language: '{{ lang }}' });
</script>
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
