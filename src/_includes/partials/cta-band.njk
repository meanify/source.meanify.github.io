{% from "partials/icons.njk" import icon %}
<section class="cta-band" aria-labelledby="ctaBandTitle">
  <div class="container cta-band__inner">
    <div>
      <h2 class="cta-band__title" id="ctaBandTitle">{{ t.ctaBand.title }}</h2>
      <p class="cta-band__text">{{ t.ctaBand.text }}</p>
    </div>
    <div class="cta-band__actions">
      <a href="{{ waUrl }}" class="btn btn--primary btn--icon" target="_blank" rel="noopener noreferrer" data-lead="whatsapp" data-cta="cta-band">{{ icon("whatsapp", 18) }} {{ t.ctaBand.whatsapp }}</a>
      <a href="{{ mailUrl }}" class="btn btn--secondary" data-lead="email" data-cta="cta-band">{{ t.ctaBand.email }}</a>
    </div>
  </div>
</section>
